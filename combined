#lambda functions and recursion
# Recursion: Calculating factorial
def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

# Lambda function: Anonymous inline function
square = lambda x: x ** 2

print(f"Factorial of 5: {factorial(5)}")
print(f"Square of 4: {square(4)}")


